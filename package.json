{
    "name": "elgato-agent-companion",
    "version": "0.1.0",
    "private": true,
    "description": "A local Stream Deck plugin for GitHub Copilot usage.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Ky7m/elgato-agent-companion.git"
    },
    "scripts": {
        "build": "rollup -c",
        "test": "tsc -p tsconfig.test.json && node -e \"require('node:fs').writeFileSync('build-test/package.json', JSON.stringify({ type: 'commonjs' }))\" && node scripts/run-tests.js",
        "link": "streamdeck link ./com.ifesenko.github-copilot-companion.sdPlugin",
        "unlink": "streamdeck unlink com.ifesenko.github-copilot-companion",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.ifesenko.github-copilot-companion\""
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.10.1",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "~26.6.4",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@elgato/streamdeck": "^3.0.0"
    }
}
