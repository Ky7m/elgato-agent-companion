{
	"extends": "@tsconfig/node20/tsconfig.json",
	"compilerOptions": {
		"module": "CommonJS",
		"moduleResolution": "Node",
		"outDir": "build-test",
		"rootDir": ".",
		"declaration": false,
		"sourceMap": false,
		"types": ["node"]
	},
	"include": [
		"src/copilot/**/*.ts",
		"test/**/*.ts"
	],
	"exclude": [
		"node_modules"
	]
}
